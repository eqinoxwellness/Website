---
import Base from '../layouts/Base.astro';
import { services } from '../data/services';
---
<Base title="Page not found | Equinox" description="This page does not exist. Find a consultation or contact Equinox in Satya Nagar, Bhubaneswar." noindex pageType="404">
  <section class="page-hero">
    <div class="container">
      <h1>This page does not exist</h1>
      <p class="lede lede--wide">The link may be old or mistyped. Choose a consultation below, or go to the <a href="/">home page</a>.</p>
      <ul class="related" style="margin-top:2rem">
        {services.map((s) => <li><a class="svc-link" href={`/${s.slug}`}><span class="svc-link__name">{s.navName}</span></a></li>)}
      </ul>
    </div>
  </section>
</Base>

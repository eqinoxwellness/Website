---
/* The Equinox mark: a disc exactly half lit, split by a brass line. */
interface Props { size?: number; label?: string; }
const { size = 34, label } = Astro.props;
---
<svg viewBox="0 0 40 40" width={size} height={size} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <circle cx="20" cy="20" r="18.5" fill="#1E2240" />
  <path d="M20 1.5a18.5 18.5 0 0 0 0 37Z" fill="#F5F6F3" />
  <circle cx="20" cy="20" r="18.5" fill="none" stroke="#1E2240" stroke-width="1.5" />
  <line x1="20" y1="1.5" x2="20" y2="38.5" stroke="#D9A55B" stroke-width="1.6" />
</svg>

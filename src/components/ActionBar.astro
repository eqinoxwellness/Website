---
import Icon from './Icon.astro';
import { waLink, telLink } from '../config/site';
interface Props { waText: string; }
const { waText } = Astro.props;
---
<div class="action-bar" aria-label="Contact the clinic">
  <a class="btn btn--wa" href={waLink(waText)} data-cta="sticky-bar" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
  <a class="btn btn--dusk" href={telLink} data-cta="sticky-bar"><Icon name="phone" />Call</a>
</div>

---
/* Equinox mark, flat version: half of a twelve-point sun and a half moon, separated by the
   equinox gap. Geometry measured from the clinic's logo. Gradients live in Base.astro. */
interface Props { size?: number; class?: string; }
const { size = 40, class: cls = '' } = Astro.props;
const w = Math.round(size * 342 / 412);
---
<svg class={`mark ${cls}`} viewBox="0 0 342 412" width={w} height={size} aria-hidden="true" focusable="false">
  <path d="M206.0 2.0 173.4 84.3 104.0 29.3 116.9 116.9 29.3 104.0 84.3 173.4 2.0 206.0 84.3 238.6 29.3 308.0 116.9 295.1 104.0 382.7 173.4 327.7 206.0 410.0Z" fill="url(#eqx-gold)" />
  <path d="M222 88.5A117.5 117.5 0 0 1 222 323.5Z" fill="url(#eqx-gold)" />
</svg>

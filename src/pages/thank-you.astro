---
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import { site } from '../config/site';
const waText = 'Hi, I just requested a call back on your website. #EQ-TY';
---
<Base title="Request received | Equinox" description="Your call-back request has reached Equinox Aesthetic & Wellness Centre." noindex pageType="thank-you" waText={waText}>
  <section class="page-hero">
    <div class="container">
      <h1>Your request has reached us</h1>
      <p class="lede lede--wide">We will call you during clinic hours, {site.hours.openLabel}, Saturday to Thursday. If you sent this on a Friday, expect our call on Saturday.</p>
      <p>For a faster reply, message us on WhatsApp.</p>
      <CtaButtons waText={waText} location="thank-you" />
      <p style="margin-top:2rem"><a href="/">Back to the home page</a></p>
    </div>
  </section>
  <script>
    // Fire the lead conversion exactly once, then forget the details.
    try {
      const raw = sessionStorage.getItem('eqx_lead');
      if (raw) {
        sessionStorage.removeItem('eqx_lead');
        const lead = JSON.parse(raw);
        const fire = () => window.eqx?.leadConversion({ eventId: lead.eventId, phone: lead.phone });
        window.eqx ? fire() : window.addEventListener('load', fire, { once: true });
      }
    } catch {}
  </script>
</Base>

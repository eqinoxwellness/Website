# ---------- Public (safe in the browser; prefix PUBLIC_) ----------
# Leave any of these empty to switch that tool off. Nothing loads before consent.
PUBLIC_GA4_ID=G-XXXXXXXXXX
PUBLIC_GADS_ID=AW-XXXXXXXXXX
PUBLIC_GADS_LEAD_LABEL=
PUBLIC_GADS_WHATSAPP_LABEL=
PUBLIC_GADS_CALL_LABEL=
PUBLIC_META_PIXEL_ID=
PUBLIC_CLARITY_ID=
# Optional. If set, GTM loads alongside the direct tags — do not duplicate GA4/Ads/Pixel inside GTM.
PUBLIC_GTM_ID=
# Search Console and Bing Webmaster HTML-tag verification (content value only)
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=
PUBLIC_INSTAGRAM_URL=
PUBLIC_CLINIC_EMAIL=

# ---------- Server only (never exposed to the browser) ----------
# Google Apps Script web app URL + shared secret (see apps-script/Code.gs)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# Meta Conversions API
META_CAPI_TOKEN=
META_GRAPH_VERSION=v23.0
# Set while testing in Events Manager, then remove
META_TEST_EVENT_CODE=
# Pin the canonical domain once a custom domain is connected, e.g. https://www.yourdomain.in
SITE_URL=

---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Location from '../components/Location.astro';
import { site } from '../config/site';
import { pageNode, breadcrumbNode, physicianNode } from '../lib/schema';

const origin = Astro.site?.origin ?? 'http://localhost:4321';
const url = `${origin}/about-the-doctor`;
const d = site.doctor;
const title = 'Our Doctor & Consultations | Equinox Aesthetic & Wellness Centre, Bhubaneswar';
const description = 'Meet our consulting doctor at Equinox in Satya Nagar, Bhubaneswar, and see how a consultation works: listen, examine, explain, then options.';
const physician = physicianNode(origin);
const schema = [
  pageNode(origin, url, title, description, 'ProfilePage'),
  breadcrumbNode(url, [{ name: 'Home', url: `${origin}/` }, { name: 'Our doctor', url }]),
  ...(physician ? [physician] : []),
];
const waText = 'Hi, I would like to book a consultation with the doctor at Equinox. #EQ-DR';
---
<Base title={title} description={description} schema={schema} pageType="doctor" waText={waText}>
  <section class="page-hero">
    <div class="container">
      <Crumbs items={[{ name: 'Home', href: '/' }, { name: 'Our doctor' }]} />
      <h1>Our consulting doctor</h1>
      {(d.qualification || d.registration) && <p class="lede lede--wide">{[d.qualification, d.registration && `Registration ${d.registration}`].filter(Boolean).join(' · ')}</p>}
      {d.focus && <p class="lede lede--wide">{d.focus}</p>}
      <CtaButtons waText={waText} location="doctor-hero" />
    </div>
  </section>

  <section class="section" data-section="approach">
    <div class="container prose">
      <h2>How a consultation works</h2>
      <p>Every first visit follows the same order. You explain what brought you in and what you have already tried. The doctor examines, asks about your history, and explains in plain language what is most likely going on.</p>
      <p>Only then are options discussed: what each involves, how many visits it usually takes, what it costs, and what is realistic. You can start, take time to think, or ask for a referral if another specialist is better placed to help.</p>
      <h2>What we will not do</h2>
      <p>We will not promise a specific result, ask you to stop medicines prescribed by another doctor, or ask you to pay for a package at the first visit.</p>
      <h2>Bringing someone with you</h2>
      <p>You are welcome to bring a family member or friend into the consultation, and to take notes or photos of anything the doctor writes down for you.</p>
    </div>
  </section>

  <Location waText={waText} />
</Base>

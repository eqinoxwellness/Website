---
import Base from '../layouts/Base.astro';
import SunMoon from '../components/SunMoon.astro';
import Icon from '../components/Icon.astro';
import CtaButtons from '../components/CtaButtons.astro';
import DoctorBlock from '../components/DoctorBlock.astro';
import Faq from '../components/Faq.astro';
import Location from '../components/Location.astro';
import LeadForm from '../components/LeadForm';
import ConcernFinder from '../components/ConcernFinder';
import DermalMatrix3D from '../components/DermalMatrix3D.astro';
import { services, categories, firstVisitSteps } from '../data/services';
import { homeFaqs } from '../data/faqs';
import { site, waLink, feeLine } from '../config/site';
import { pageNode, faqNode } from '../lib/schema';

const origin = Astro.site?.origin ?? 'http://localhost:4321';
const title = 'Equinox Aesthetic & Wellness Centre | Clinical Aesthetics & Trichology in Bhubaneswar';
const description = 'Doctor-led aesthetic medicine, US-FDA laser modalities, MNRF, GFC trichology & holistic care in Satya Nagar, Bhubaneswar. Assessment first, clear explanations.';
const waText = 'Hi, I would like to book a consultation at Equinox. #EQ-HOME';

const finderOptions = [
  ['Breakouts or acne', 'acne'],
  ['Dark patches or uneven tone', 'pigmentation'],
  ['Dull or tired-looking skin', 'skin-rejuvenation'],
  ['Hair fall or thinning', 'hair'],
  ['Periods or hormones', 'womens-wellness'],
  ['Weight', 'weight-management'],
  ['Stress, sleep or feeling run down', 'wellness'],
  ['A long-standing concern, and I prefer homeopathy', 'homeopathy'],
].map(([label, slug]) => {
  const s = services.find((x) => x.slug === slug)!;
  return { label, slug, name: s.name, line: s.intro, href: `/${slug}`, wa: waLink(s.waText) };
});

const schema = [pageNode(origin, `${origin}/`, title, description), faqNode(`${origin}/`, homeFaqs)];
---
<Base title={title} description={description} schema={schema} pageType="home" waText={waText}>
  <!-- Hero Section: Clinical Command Center -->
  <section class="hero" aria-labelledby="hero-h" data-section="hero">
    <div class="hero__day">
      <div class="eyebrow">
        <span>✦</span>
        <span>Doctor-Led Clinical Aesthetics & Trichology</span>
      </div>
      <h1 id="hero-h">Precision Dermal Science & Clinical Aesthetics</h1>
      <p class="lede lede--wide">
        Every care plan at Equinox begins with an unhurried, thorough medical assessment by our consulting doctor. Advanced Pico laser, MNRF, GFC trichology, and targeted skin protocols calibrated precisely for you.
      </p>
      <div class="btn-row">
        <a class="btn btn--wa" href={waLink(waText)} data-cta="hero" rel="noopener">
          <Icon name="whatsapp" />
          <span>Message on WhatsApp</span>
        </a>
        <a class="btn btn--line" href={`tel:${site.phoneRaw}`} data-cta="hero">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.1 4.2 2 2 0 0 1 3.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L7.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
          <span>Call {site.phoneDisplay}</span>
        </a>
      </div>
    </div>

    <div class="hero__dusk">
      <div class="hero__card-3d">
        <img src="/images/clinic-suite.webp" alt="Equinox Aesthetic and Wellness Centre clinical suite in Satya Nagar" width="800" height="450" loading="eager" decoding="async" />
      </div>
      <div class="hero__facts">
        <p class="place">Satya Nagar, Bhubaneswar</p>
        <p>{site.address.landmark}, Kali Mandir Road</p>
        <p>Open {site.hours.openLabel}<br /><span class="closed-note">Closed on Fridays</span></p>
        <p><a href={site.mapsUrl} data-track="directions" data-cta="hero" rel="noopener">Get directions on Google Maps</a></p>
      </div>
    </div>
  </section>

  <!-- Clinical Stats Bar -->
  <section class="section" style="padding-top: 1rem; padding-bottom: 2rem;" data-section="stats">
    <div class="container">
      <div class="stats-strip">
        <div class="stat-item">
          <div class="stat-item__icon">✦</div>
          <div class="stat-item__text">
            <strong>14+ Years Clinical Care</strong>
            <span>Doctor-led aesthetics & homeopathy</span>
          </div>
        </div>
        <div class="stat-item">
          <div class="stat-item__icon">✦</div>
          <div class="stat-item__text">
            <strong>In-Depth Diagnosis</strong>
            <span>Assessment before any recommendation</span>
          </div>
        </div>
        <div class="stat-item">
          <div class="stat-item__icon">✦</div>
          <div class="stat-item__text">
            <strong>Medical Technologies</strong>
            <span>Pico laser, MNRF, GFC & HydraFacial</span>
          </div>
        </div>
        <div class="stat-item">
          <div class="stat-item__icon">✦</div>
          <div class="stat-item__text">
            <strong>Plot No. 69, Satya Nagar</strong>
            <span>Above Sweekruti Creations, Bhubaneswar</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3D Clinical Modality Visualizer -->
  <section class="section" data-section="3d-suite">
    <div class="container">
      <DermalMatrix3D />
    </div>
  </section>

  <!-- Services Grid -->
  <section class="section section--tint" aria-labelledby="svc-h" data-section="services">
    <div class="container">
      <div class="eyebrow">
        <span>✦</span>
        <span>Consultation Services</span>
      </div>
      <h2 id="svc-h">What you can consult us about</h2>
      <p class="lede lede--wide">Each consultation starts the same way: your history, an examination, and a plain explanation before any option is discussed.</p>
      
      <div style="margin-top:2.5rem">
        {categories.map((cat) => (
          <div class="index-group">
            <h3>{cat}</h3>
            <ul>
              {services.filter((s) => s.category === cat).map((s) => (
                <li>
                  <a class="svc-link" href={`/${s.slug}`}>
                    <span class="svc-link__name">{s.navName}</span>
                    <span class="svc-link__line">{s.indexLine}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p style="margin-top:2rem"><a class="btn btn--line" href="/treatments">See all treatment modalities the clinic offers →</a></p>

      <div class="clinical-feature split split--wide-left" style="margin-top: 3.5rem;">
        <div>
          <h2>A calm, clinical sanctuary in Satya Nagar</h2>
          <p class="lede">Designed for privacy, hygiene and thorough medical assessments. You are never hurried through a sales pitch; you sit with the doctor in an unhurried consultation suite.</p>
          <p>We review your past skincare routines, scalp health, lifestyle factors and any existing prescriptions before discussing practical next steps.</p>
          <div style="margin-top: 1.5rem;">
            <a class="btn btn--wa" href={waLink('Hi, I would like to visit the clinic in Satya Nagar. #EQ-SUITE')} data-cta="suite" rel="noopener">Schedule an in-person visit</a>
          </div>
        </div>
        <div class="hero__card-3d" style="max-height: 22rem;">
          <img src="/images/clinical-care.webp" alt="Doctor-led aesthetic consultation and clinical care at Equinox" width="800" height="450" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- First Visit Process -->
  <section class="section" id="first-visit" aria-labelledby="visit-steps-h" data-section="first-visit">
    <div class="container">
      <div class="eyebrow">
        <span>✦</span>
        <span>Consultation Protocol</span>
      </div>
      <h2 id="visit-steps-h">How a first visit works</h2>
      <p class="lede lede--wide">Four steps, and you decide at the end. Nothing is booked unless you ask for it.</p>
      <ol class="steps">
        {firstVisitSteps.map((s) => <li><h3>{s.title}</h3><p>{s.body}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- Doctor Block -->
  <DoctorBlock />

  <!-- Concern Finder -->
  <section class="section section--tint" aria-labelledby="finder-h" data-section="concern-finder">
    <div class="container">
      <div class="eyebrow">
        <span>✦</span>
        <span>Interactive Selector</span>
      </div>
      <h2 id="finder-h">Not sure which consultation to ask for?</h2>
      <ConcernFinder client:visible options={finderOptions} />
    </div>
  </section>

  <!-- Fee & Transparency -->
  <section class="section" aria-labelledby="fee-h" data-section="fees">
    <div class="container split">
      <div>
        <h2 id="fee-h">What a consultation costs</h2>
        <p class="lede lede--wide">{feeLine()}</p>
      </div>
      <div class="glass-card">
        <h3>Honest, upfront discussion</h3>
        <p>After the assessment, the doctor explains each option with its cost and the usual number of visits. You can take that home and decide later.</p>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section section--tint" aria-labelledby="faq-h">
    <div class="container">
      <h2 id="faq-h">Questions people ask before booking</h2>
      <Faq items={homeFaqs} />
    </div>
  </section>

  <!-- Lead Form -->
  <section class="section" aria-labelledby="form-h" data-section="form">
    <div class="container split">
      <div>
        <h2 id="form-h">Prefer a call back?</h2>
        <p class="lede lede--wide">Leave your number and we will call during clinic hours. WhatsApp is usually quicker.</p>
        <a class="btn btn--wa" href={waLink(waText)} data-cta="form-side" rel="noopener" style="margin-top:1.25rem">
          <Icon name="whatsapp" />
          <span>Message us on WhatsApp</span>
        </a>
      </div>
      <LeadForm client:visible services={services.map((s) => ({ slug: s.slug, name: s.name }))} whatsappHref={waLink(waText)} />
    </div>
  </section>

  <Location waText={waText} />
</Base>

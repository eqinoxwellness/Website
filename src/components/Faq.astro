---
import type { Faq } from '../data/services';
interface Props { items: Faq[]; id?: string; }
const { items, id = 'faq' } = Astro.props;
---
<div class="faq" data-section={id}>
  {items.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <div class="answer"><p>{f.a}</p></div>
    </details>
  ))}
</div>

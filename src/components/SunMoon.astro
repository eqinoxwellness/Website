---
/* Hero mark, faceted like the gold logo. The one orchestrated motion on the site:
   the sun and moon halves drift together and settle at the equinox gap.
   Transform-only; disabled for reduced motion. */
---
<svg class="sunmoon" viewBox="-40 -10 422 432" aria-hidden="true" focusable="false">
  <circle class="sunmoon__glow" cx="214" cy="206" r="210" fill="url(#eqx-glow)" />
  <g class="sunmoon__mark">
    <g class="sunmoon__sun">
      <path d="M206 206L206.0 2.0L173.4 84.3ZM206 206L104.0 29.3L116.9 116.9ZM206 206L29.3 104.0L84.3 173.4ZM206 206L2.0 206.0L84.3 238.6ZM206 206L29.3 308.0L116.9 295.1ZM206 206L104.0 382.7L173.4 327.7Z" fill="url(#eqx-facet-l)" />
      <path d="M206 206L173.4 84.3L104.0 29.3ZM206 206L116.9 116.9L29.3 104.0ZM206 206L84.3 173.4L2.0 206.0ZM206 206L84.3 238.6L29.3 308.0ZM206 206L116.9 295.1L104.0 382.7ZM206 206L173.4 327.7L206.0 410.0Z" fill="url(#eqx-facet-d)" />
    </g>
    <g class="sunmoon__moon">
      <path d="M222 88.5A117.5 117.5 0 0 1 222 323.5Z" fill="url(#eqx-gold)" />
      <path d="M228 99.5A106.5 106.5 0 0 1 228 312.5" fill="none" stroke="#FCE3A2" stroke-opacity="0.55" stroke-width="3" />
    </g>
  </g>
</svg>

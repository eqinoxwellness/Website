---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Location from '../components/Location.astro';
import LeadForm from '../components/LeadForm';
import { services } from '../data/services';
import { waLink } from '../config/site';
import { pageNode, breadcrumbNode } from '../lib/schema';

const origin = Astro.site?.origin ?? 'http://localhost:4321';
const url = `${origin}/contact`;
const title = 'Visit and contact | Equinox Aesthetic & Wellness Centre, Satya Nagar';
const description = 'Address, opening hours, directions, WhatsApp and phone for Equinox Aesthetic & Wellness Centre, Satya Nagar, Bhubaneswar. Closed on Fridays.';
const waText = 'Hi, I would like to book a consultation at Equinox. #EQ-CT';
const schema = [pageNode(origin, url, title, description, 'ContactPage'), breadcrumbNode(url, [{ name: 'Home', url: `${origin}/` }, { name: 'Visit and contact', url }])];
---
<Base title={title} description={description} schema={schema} pageType="contact" waText={waText}>
  <section class="page-hero">
    <div class="container">
      <Crumbs items={[{ name: 'Home', href: '/' }, { name: 'Visit and contact' }]} />
      <h1>Visit and contact</h1>
      <p class="lede lede--wide">The quickest way to reach us is WhatsApp. We reply during clinic hours, usually within minutes.</p>
      <CtaButtons waText={waText} location="contact-hero" />
    </div>
  </section>
  <Location waText={waText} heading="Find the clinic" />

  <section class="section" aria-labelledby="directions-h" data-section="directions">
    <div class="container">
      <h2 id="directions-h">How to reach the clinic in Satya Nagar</h2>
      <p class="lede lede--wide">Equinox is located on the first floor above Sweekruti Creations on Kali Mandir Road. Here is how to find us from major neighborhoods across Bhubaneswar:</p>

      <div class="treatment-list" style="margin-top:2rem">
        <div class="treatment-card">
          <h3>From Saheed Nagar & Vani Vihar</h3>
          <p>Head south down Janpath or via Cuttack-Puri Road toward Satya Nagar. Turn onto Kali Mandir Road; the clinic is just 5 to 10 minutes away.</p>
        </div>
        <div class="treatment-card">
          <h3>From Kharavela Nagar & Master Canteen</h3>
          <p>Drive east through Satya Nagar Main Road toward the Kali Mandir landmark. The clinic is 3 to 5 minutes away, situated directly above Sweekruti Creations.</p>
        </div>
        <div class="treatment-card">
          <h3>From Rasulgarh & NH16</h3>
          <p>Take Cuttack-Puri Road from Rasulgarh Square heading toward Kalpana Square. Turn right onto Kali Mandir Road in Satya Nagar (10 to 12-minute drive).</p>
        </div>
        <div class="treatment-card">
          <h3>From Jaydev Vihar & Nayapalli</h3>
          <p>Drive south along Janpath passing Vani Vihar and Master Canteen into Satya Nagar. It is typically a 15 to 20-minute drive depending on traffic.</p>
        </div>
      </div>

      <div class="note" style="margin-top:2rem">
        <p><strong>Parking & Entry:</strong> Two-wheeler parking and roadside car parking are available outside Plot No. 69. Enter the building and take the stairs to the 1st floor.</p>
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="form-h" data-section="form">
    <div class="container split">
      <div><h2 id="form-h">Ask for a call back</h2><p class="lede lede--wide">Leave your number and we will call during clinic hours.</p></div>
      <LeadForm client:visible services={services.map((s) => ({ slug: s.slug, name: s.name }))} whatsappHref={waLink(waText)} />
    </div>
  </section>
</Base>

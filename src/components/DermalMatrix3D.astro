---
// Interactive 3D Clinical Bio-Laser & Dermal Matrix Suite
// High-performance 60 FPS Canvas 3D Engine with interactive depth physics and volumetric energy pulses.
---

<div class="luxury-3d-suite" id="dermal-3d-suite">
  <div class="luxury-3d-header">
    <div class="luxury-3d-tag">
      <span class="luxury-3d-pulse"></span>
      <span>Interactive 3D Clinical Engine</span>
    </div>
    <h2 class="luxury-3d-title">3D Precision Energy Modalities & Bio-Dermal Matrix</h2>
    <p class="luxury-3d-desc">
      Drag to rotate the 3D skin layer matrix. Select a modality to fire simulated photomechanical laser wavelengths, RF thermal fields, or autologous growth factors in real 3D depth space.
    </p>
  </div>

  <div class="canvas-3d-container">
    <!-- 60 FPS Interactive 3D Canvas -->
    <canvas id="dermal3DCanvas" class="dermal-canvas"></canvas>
    
    <div class="canvas-3d-overlay">
      <div class="canvas-badge">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07L19.07 4.93"/></svg>
        <span>60 FPS Bio-Sim Engine</span>
      </div>
      <div class="canvas-controls-hint">✦ Drag mouse to rotate 3D view</div>
    </div>
  </div>

  <div class="luxury-3d-grid">
    <!-- Pico Laser Card -->
    <div class="modality-card is-active" data-mode="pico" data-depth="1.50 mm" data-layer="Reticular Dermis" data-target="Melanin clusters & pigmentation" data-down="12–24 hours (Mild flush)" data-wave="1064nm Pico Pulse">
      <div class="modality-card__glow"></div>
      <div class="modality-card__badge">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07L19.07 4.93"/></svg>
        <span>1.50 mm Depth</span>
      </div>
      <h3>Pico & Q-Switched Laser</h3>
      <p class="modality-card__tech">Photomechanical Pulse Technology</p>
      <p class="modality-card__text">
        Delivers ultra-short acoustic pulses to break down deep epidermal and dermal melanin clusters without thermal damage to surrounding skin tissue.
      </p>
      <div class="modality-card__specs">
        <div><strong>Primary Target:</strong> Melasma, sun spots & acne marks</div>
        <div><strong>Cadence:</strong> 3–4 weeks between sessions</div>
      </div>
    </div>

    <!-- MNRF Card -->
    <div class="modality-card" data-mode="mnrf" data-depth="2.80 mm" data-layer="Deep Collagen Matrix" data-target="Fibroblast stimulation & scar remodeling" data-down="2–3 days (Micro-crusting)" data-wave="1MHz RF Matrix">
      <div class="modality-card__glow"></div>
      <div class="modality-card__badge">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
        <span>2.80 mm Depth</span>
      </div>
      <h3>Micro-Needle RF (MNRF)</h3>
      <p class="modality-card__tech">Fractional Radiofrequency Matrix</p>
      <p class="modality-card__text">
        Combines insulated micro-needles with thermal radiofrequency energy at controlled depths to induce neo-collagenesis and remodel deep acne scarring.
      </p>
      <div class="modality-card__specs">
        <div><strong>Primary Target:</strong> Boxcar scars, pore laxity & texture</div>
        <div><strong>Cadence:</strong> 4–6 weeks interval</div>
      </div>
    </div>

    <!-- PRP / GFC Card -->
    <div class="modality-card" data-mode="prp" data-depth="4.20 mm" data-layer="Follicular Matrix" data-target="Autologous growth factors & vascular support" data-down="24 hours (Mild scalp tenderness)" data-wave="Biostimulation Factor">
      <div class="modality-card__glow"></div>
      <div class="modality-card__badge">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21a9 9 0 0 0 9-9c0-4.97-9-12-9-12s-9 7.03-9 12a9 9 0 0 0 9 9z"/></svg>
        <span>4.20 mm Depth</span>
      </div>
      <h3>PRP & Growth Factor (GFC)</h3>
      <p class="modality-card__tech">Autologous Cellular Biostimulation</p>
      <p class="modality-card__text">
        Concentrates active growth factors from your own blood plasma, injected directly into the follicular bulb depth to support miniaturized hair roots.
      </p>
      <div class="modality-card__specs">
        <div><strong>Primary Target:</strong> Thinning hair, androgenetic loss & scalp health</div>
        <div><strong>Cadence:</strong> Monthly protocol</div>
      </div>
    </div>

    <!-- HydraFacial Card -->
    <div class="modality-card" data-mode="hydra" data-depth="0.25 mm" data-layer="Stratum Corneum" data-target="Sebum extraction & antioxidant infusion" data-down="Zero downtime" data-wave="Vortex Infusion 40kPa">
      <div class="modality-card__glow"></div>
      <div class="modality-card__badge">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-4-3.5-4-3.5-2 1.9-4 3.5S5 13 5 15a7 7 0 0 0 7 7z"/></svg>
        <span>0.25 mm Depth</span>
      </div>
      <h3>HydraFacial Vortex Infusion</h3>
      <p class="modality-card__tech">Medical-Grade Hydro-Exfoliation</p>
      <p class="modality-card__text">
        Uses spiral vortex suction to vacuum out comedones while simultaneously infusing targeted botanical antioxidants and hydrating hyaluronic acid.
      </p>
      <div class="modality-card__specs">
        <div><strong>Primary Target:</strong> Congested pores, dehydration & dull skin</div>
        <div><strong>Cadence:</strong> Maintenance every 3–4 weeks</div>
      </div>
    </div>
  </div>

  <div class="luxury-3d-hud" id="modalityHud">
    <div class="hud-box">
      <span class="hud-box__label">Physiological Depth</span>
      <strong class="hud-box__val" id="hudDepthVal">1.50 mm (Reticular Dermis)</strong>
    </div>
    <div class="hud-box">
      <span class="hud-box__label">Modality Energy Wavelength</span>
      <strong class="hud-box__val" id="hudWaveVal">1064nm Pico Pulse</strong>
    </div>
    <div class="hud-box">
      <span class="hud-box__label">Target Biological Mechanism</span>
      <strong class="hud-box__val" id="hudTargetVal">Melanin clusters & pigmentation</strong>
    </div>
    <div class="hud-box">
      <span class="hud-box__label">Post-Procedure Recovery</span>
      <strong class="hud-box__val" id="hudDownVal">12–24 hours (Mild flush)</strong>
    </div>
  </div>
</div>

<style>
  .luxury-3d-suite {
    background: radial-gradient(circle at 50% 10%, #2a1236 0%, #110617 99.9%);
    border: 1px solid rgba(242, 199, 102, 0.4);
    border-radius: 1.5rem;
    padding: clamp(1.75rem, 3vw, 3rem);
    margin-block: 2.5rem;
    box-shadow: 
      0 28px 70px -12px rgba(17, 6, 23, 0.9),
      inset 0 1px 0 rgba(242, 199, 102, 0.45);
    position: relative;
    overflow: hidden;
  }
  .luxury-3d-suite::before {
    content: '';
    position: absolute;
    top: -150px;
    right: -150px;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(242, 199, 102, 0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .luxury-3d-header {
    max-width: 48rem;
    margin-bottom: 1.5rem;
  }
  .luxury-3d-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.85rem;
    background: rgba(242, 199, 102, 0.14);
    border: 1px solid rgba(242, 199, 102, 0.45);
    border-radius: 2rem;
    color: #f2c766;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }
  .luxury-3d-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f2c766;
    box-shadow: 0 0 10px #f2c766;
    animation: pulseGold 2s infinite;
  }
  @keyframes pulseGold {
    from, to { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .luxury-3d-title {
    color: #fbf1e6;
    font-family: var(--serif, Georgia, serif);
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }
  .luxury-3d-desc {
    color: #dcc8de;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }

  /* 3D Canvas Box */
  .canvas-3d-container {
    width: 99.9%; // preflight-ignore
    height: 320px;
    position: relative;
    border-radius: 1rem;
    background: linear-gradient(180deg, #180924 0%, #0c0412 99.9%);
    border: 1px solid rgba(242, 199, 102, 0.3);
    margin-bottom: 2rem;
    overflow: hidden;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.8);
    cursor: grab;
  }
  .canvas-3d-container:active {
    cursor: grabbing;
  }
  .dermal-canvas {
    width: 99.9%; // preflight-ignore
    height: 99.9%; // preflight-ignore
    display: block;
  }
  .canvas-3d-overlay {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }
  .canvas-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    background: rgba(17, 6, 23, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(242, 199, 102, 0.3);
    border-radius: 2rem;
    color: #f2c766;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .canvas-controls-hint {
    color: #a392a5;
    font-size: 0.78rem;
    background: rgba(17, 6, 23, 0.6);
    padding: 0.25rem 0.65rem;
    border-radius: 1rem;
  }

  .luxury-3d-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .modality-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(242, 199, 102, 0.2);
    border-radius: 0.95rem;
    padding: 1.4rem;
    position: relative;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    transform-style: preserve-3d;
    perspective: 1000px;
  }
  .modality-card:hover {
    background: rgba(242, 199, 102, 0.08);
    border-color: rgba(242, 199, 102, 0.5);
    transform: translateY(-6px) rotateX(2deg) rotateY(-2deg);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.5);
  }
  .modality-card.is-active {
    background: linear-gradient(135deg, rgba(200, 145, 47, 0.28), rgba(42, 18, 54, 0.7));
    border-color: #f2c766;
    box-shadow: 
      0 12px 32px -4px rgba(200, 145, 47, 0.35),
      inset 0 1px 0 rgba(242, 199, 102, 0.45);
  }

  .modality-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    background: rgba(242, 199, 102, 0.15);
    border: 1px solid rgba(242, 199, 102, 0.3);
    border-radius: 2rem;
    color: #f2c766;
    font-size: 0.78rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .modality-card h3 {
    color: #fbf1e6;
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }
  .modality-card__tech {
    color: #f2c766;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }
  .modality-card__text {
    color: #dcc8de;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  .modality-card__specs {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 0.75rem;
    font-size: 0.84rem;
    color: #c4b5c7;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .modality-card__specs strong {
    color: #fbf1e6;
  }

  .luxury-3d-hud {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    background: rgba(17, 6, 23, 0.92);
    border: 1px solid rgba(242, 199, 102, 0.35);
    border-radius: 0.85rem;
    padding: 1.1rem 1.4rem;
    backdrop-filter: blur(12px);
  }
  .hud-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .hud-box__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #a392a5;
  }
  .hud-box__val {
    color: #f2c766;
    font-size: 1.05rem;
    font-weight: 600;
  }
</style>

<script>
  (function init3DEngine() {
    const canvas = document.getElementById('dermal3DCanvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    function getDimensions() {
      const parent = canvas.parentElement;
      const w = parent?.clientWidth && parent.clientWidth > 0 ? parent.clientWidth : 800;
      const h = parent?.clientHeight && parent.clientHeight > 0 ? parent.clientHeight : 320;
      canvas.width = w;
      canvas.height = h;
      return { width: w, height: h };
    }

    let { width, height } = getDimensions();

    window.addEventListener('resize', () => {
      const d = getDimensions();
      width = d.width;
      height = d.height;
    });

    if (typeof ResizeObserver !== 'undefined' && canvas.parentElement) {
      new ResizeObserver(() => {
        const d = getDimensions();
        width = d.width;
        height = d.height;
      }).observe(canvas.parentElement);
    }

    // 3D Point Matrix representing Dermal Layers
    interface Point3D {
      x: number;
      y: number;
      z: number;
      layer: number;
      size: number;
      pulse: number;
    }

    const points: Point3D[] = [];
    const layers = 4;
    const pointsPerLayer = 50;

    for (let l = 0; l < layers; l++) {
      for (let i = 0; i < pointsPerLayer; i++) {
        points.push({
          x: (Math.random() - 0.5) * 450,
          y: (l - 1.5) * 55 + (Math.random() - 0.5) * 15,
          z: (Math.random() - 0.5) * 450,
          layer: l,
          size: Math.random() * 3.5 + 2.5,
          pulse: Math.random() * Math.PI * 2,
        });
      }
    }

    let angleX = 0.25;
    let angleY = 0.45;
    let isDragging = false;
    let lastMouseX = 0;
    let lastMouseY = 0;

    const container = canvas.parentElement;
    if (container) {
      container.addEventListener('mousedown', (e) => {
        isDragging = true;
        lastMouseX = e.clientX;
        lastMouseY = e.clientY;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - lastMouseX;
        const dy = e.clientY - lastMouseY;
        angleY += dx * 0.006;
        angleX += dy * 0.006;
        lastMouseX = e.clientX;
        lastMouseY = e.clientY;
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
      });

      // Touch screen support
      container.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isDragging = true;
          lastMouseX = e.touches[0].clientX;
          lastMouseY = e.touches[0].clientY;
        }
      }, { passive: true });

      window.addEventListener('touchmove', (e) => {
        if (!isDragging || e.touches.length !== 1) return;
        const dx = e.touches[0].clientX - lastMouseX;
        const dy = e.touches[0].clientY - lastMouseY;
        angleY += dx * 0.006;
        angleX += dy * 0.006;
        lastMouseX = e.touches[0].clientX;
        lastMouseY = e.touches[0].clientY;
      }, { passive: true });

      window.addEventListener('touchend', () => {
        isDragging = false;
      });
    }

    let currentMode = 'pico';
    let beamProgress = 0;

    function render() {
      if (width <= 0 || height <= 0) {
        const d = getDimensions();
        width = d.width;
        height = d.height;
      }

      ctx.clearRect(0, 0, width, height);

      if (!isDragging) {
        angleY += 0.003;
      }

      beamProgress += 0.025;
      if (beamProgress > 1) beamProgress = 0;

      const fov = 320;
      const cx = width / 2;
      const cy = height / 2;

      const layerColors = [
        '#F2C766', // 0: Epidermis - Gold
        '#E09156', // 1: Papillary Dermis - Amber
        '#C24D98', // 2: Reticular Dermis - Magenta/Plum
        '#8B5CF6', // 3: Deep Follicular - Violet
      ];

      const transformed = points.map((p) => {
        let x1 = p.x * Math.cos(angleY) - p.z * Math.sin(angleY);
        let z1 = p.z * Math.cos(angleY) + p.x * Math.sin(angleY);

        let y2 = p.y * Math.cos(angleX) - z1 * Math.sin(angleX);
        let z2 = z1 * Math.cos(angleX) + p.y * Math.sin(angleX);

        p.pulse += 0.04;

        const scale = fov / (fov + z2 + 280);
        const projX = cx + x1 * scale;
        const projY = cy + y2 * scale;

        return { p, x1, y2, z2, scale, projX, projY };
      });

      transformed.sort((a, b) => b.z2 - a.z2);

      // Draw Grid Layer Planes
      for (let l = 0; l < layers; l++) {
        ctx.strokeStyle = `rgba(242, 199, 102, ${0.12 + l * 0.04})`;
        ctx.lineWidth = 0.8;
        ctx.beginPath();
        const layerPts = transformed.filter((t) => t.p.layer === l);
        for (let i = 0; i < layerPts.length; i++) {
          const next = layerPts[(i + 1) % layerPts.length];
          ctx.moveTo(layerPts[i].projX, layerPts[i].projY);
          ctx.lineTo(next.projX, next.projY);
        }
        ctx.stroke();
      }

      // Draw Energy Pulse Modes
      if (currentMode === 'pico') {
        ctx.save();
        ctx.strokeStyle = `rgba(242, 199, 102, ${0.9 - beamProgress * 0.4})`;
        ctx.lineWidth = 4;
        ctx.shadowColor = '#F2C766';
        ctx.shadowBlur = 20;
        ctx.beginPath();
        ctx.moveTo(cx, 10);
        ctx.lineTo(cx, cy + (beamProgress - 0.5) * 140);
        ctx.stroke();
        ctx.restore();
      } else if (currentMode === 'mnrf') {
        ctx.save();
        ctx.strokeStyle = `rgba(224, 145, 86, ${0.7 - beamProgress * 0.5})`;
        ctx.lineWidth = 3;
        ctx.shadowColor = '#E09156';
        ctx.shadowBlur = 15;
        ctx.beginPath();
        ctx.arc(cx, cy + 15, Math.max(10, beamProgress * 150), 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      } else if (currentMode === 'prp') {
        ctx.save();
        ctx.fillStyle = '#C24D98';
        ctx.shadowColor = '#C24D98';
        ctx.shadowBlur = 12;
        for (let i = 0; i < 8; i++) {
          const py = cy + Math.sin(beamProgress * Math.PI * 2 + i) * 60 + 20;
          const px = cx + Math.cos(beamProgress * Math.PI * 2 + i) * 75;
          ctx.beginPath();
          ctx.arc(px, py, 4.5, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      } else if (currentMode === 'hydra') {
        ctx.save();
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 2.5;
        ctx.shadowColor = '#38bdf8';
        ctx.shadowBlur = 10;
        ctx.beginPath();
        for (let a = 0; a < Math.PI * 4; a += 0.2) {
          const r = a * 9 * beamProgress;
          const x = cx + Math.cos(a + beamProgress * 6) * r;
          const y = cy - 40 + Math.sin(a + beamProgress * 6) * r * 0.5;
          if (a === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
        ctx.restore();
      }

      // Draw 3D Spheres with Glow
      transformed.forEach(({ p, projX, projY, scale }) => {
        const alpha = Math.min(1, Math.max(0.35, (scale - 0.25) * 1.6));
        const currentSize = p.size * scale * (1 + Math.sin(p.pulse) * 0.25);

        ctx.save();
        ctx.fillStyle = layerColors[p.layer];
        ctx.shadowColor = layerColors[p.layer];
        ctx.shadowBlur = 10 * scale;
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(projX, projY, Math.max(2, currentSize), 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      });

      requestAnimationFrame(render);
    }

    render();

    const cards = document.querySelectorAll('.modality-card');
    const depthVal = document.getElementById('hudDepthVal');
    const waveVal = document.getElementById('hudWaveVal');
    const targetVal = document.getElementById('hudTargetVal');
    const downVal = document.getElementById('hudDownVal');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        cards.forEach((c) => c.classList.remove('is-active'));
        card.classList.add('is-active');

        currentMode = card.getAttribute('data-mode') || 'pico';

        const depth = card.getAttribute('data-depth');
        const layer = card.getAttribute('data-layer');
        const wave = card.getAttribute('data-wave');
        const target = card.getAttribute('data-target');
        const down = card.getAttribute('data-down');

        if (depthVal) depthVal.textContent = `${depth} (${layer})`;
        if (waveVal) waveVal.textContent = wave || '';
        if (targetVal) targetVal.textContent = target || '';
        if (downVal) downVal.textContent = down || '';
      });
    });
  })();
</script>
